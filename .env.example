# File Viewer: copy this file to `.env` and fill in the values.
#   cp .env.example .env

# --- Database (PostgreSQL) ---
# Used by the app, `prisma migrate deploy`, and scripts/cleanup-expired-files.ts.
# Quick local database:
#   docker run --name fileviewer-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=fileviewer -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fileviewer?schema=public"

# --- Object storage (Cloudflare R2) ---
# Cloudflare dashboard -> R2:
#   1. Create a bucket (keep it private) and put its name in R2_BUCKET_NAME.
#   2. Account ID: shown on the R2 overview page (right sidebar).
#   3. "Manage API tokens" -> Create API token with "Object Read & Write",
#      scoped to this bucket. Copy the Access Key ID and Secret Access Key.
#   4. Bucket -> Settings -> CORS policy (needed for browser uploads), see README.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="file-viewer"
# Optional: override the endpoint (e.g. EU jurisdiction buckets):
#   https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=""

# --- Email (SMTP), used to send the 6-digit sign-in codes ---
# Any SMTP provider works (Mailtrap, Resend SMTP, SES, Gmail app password, ...).
# SMTP_SECURE="true" for port 465, "false" for 587/25/2525.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="File Viewer <no-reply@example.com>"

# --- Sessions ---
# Signs session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=""
# Optional: extra secret mixed into the stored sign-in code hashes (falls back to SESSION_SECRET).
# OTP_PEPPER=""

# --- App ---
# Public origin of the app, used for absolute links in emails.
APP_URL="http://localhost:3000"
# Optional: port for `npm start` / Docker (default 3000).
# PORT="3000"
